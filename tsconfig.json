{
  "compilerOptions": {
    "target": "ES2022",               // like jvmTarget: which JavaScript version you write for
    "lib": ["ES2023"],                // which version of the built-in standard library you may use
    "module": "ESNext",               // use import/export
    "moduleResolution": "Bundler",    // import "./hello" finds hello.ts without an extension
    "strict": true,                   // Kotlin-style null safety and strict type checks
    "noUncheckedIndexedAccess": true, // list[0] is "value or undefined", like getOrNull(0)
    "noEmit": true,                   // only check for errors, write no output files
    "skipLibCheck": true,             // don't re-check the type files inside node_modules
    "moduleDetection": "force",       // treat every file as module
    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "node_modules/vitest/globals.d.ts"
  ]
  // your source sets: every .ts file under src and tests
}